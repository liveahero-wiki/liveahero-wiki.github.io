       "tooltip": {
        "formatter": "Android<br>311 (78.7%)"
       }
      },
      {
       "value": [
        "iOS",
        79,
        20.0
       ],
       "tooltip": {
        "formatter": "iOS<br>79 (20%)"
       }
      },
      {
       "value": [
        "Other Emulator on PC",
        41,
        10.4
       ],
       "tooltip": {
        "formatter": "Other Emulator on PC<br>41 (10.4%)"
       }
      },
      {
       "value": [
        "Google Play Games on PC",
        12,
        3.0
       ],
       "tooltip": {
        "formatter": "Google Play Games on PC<br>12 (3%)"
       }
      }
     ],
     "encode": {
      "x": 1,
      "y": 0
     },
     "label": {
      "show": true,
      "position": "right",
      "formatter": "{@[1]} ({@[2]}%)"
     },
     "itemStyle": {
      "borderRadius": [
       0,
       4,
       4,
       0
      ]
     },
     "barMaxWidth": 28
    }
   ]
  },
  "note": "Multiple answers allowed, so the percentages add up to more than 100%."
 },
