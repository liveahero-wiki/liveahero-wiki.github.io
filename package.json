{
  "name": "lah-skill-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.cms-plugin.config.ts && vite build --config vite.team-creator.config.ts && vite build --config vite.editor.config.ts && vite build --config vite.cms-tl-plugins.config.ts",
    "build:cms-plugin": "vite build --config vite.cms-plugin.config.ts",
    "build:team-creator": "vite build --config vite.team-creator.config.ts",
    "build:editor": "vite build --config vite.editor.config.ts",
    "build:cms-tl-plugins": "vite build --config vite.cms-tl-plugins.config.ts",
    "dev:cms-plugin": "vite --config vite.cms-plugin.config.ts --port 5191 --strictPort",
    "watch:cms-plugin": "vite build --watch --config vite.cms-plugin.config.ts",
    "typecheck:cms-plugin": "tsc --noEmit -p web/cms-plugin/tsconfig.json",
    "typecheck:team-creator": "tsc --noEmit -p web/team-creator/tsconfig.json",
    "typecheck:editor": "tsc --noEmit -p web/editor/tsconfig.json",
    "typecheck:cms-tl-plugins": "tsc --noEmit -p web/cms-tl-plugins/tsconfig.json",
    "test:cms-plugin": "node --test \"web/cms-plugin/**/*.test.ts\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "eleventy:dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eleventy --serve --incremental",
    "eleventy:dev:fast": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eleventy --serve --incremental --ignore-initial",
    "eleventy:build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eleventy",
    "eleventy:strict": "cross-env ELEVENTY_STRICT=1 NODE_OPTIONS=--max-old-space-size=8192 eleventy",
    "test": "node --test \"wiki_plugins/**/*.test.js\" \"web/cms-plugin/**/*.test.ts\" \"web/team-creator/**/*.test.ts\" \"web/editor/**/*.test.ts\" \"web/cms-tl-plugins/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.15",
    "downshift": "9.4.0",
    "html-minifier-terser": "^7.2.0",
    "image-size": "^2.0.4",
    "js-yaml": "^4.3.2",
    "liquidjs": "^10.30.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.3",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "preact": "^10.29.8",
    "sass": "^1.104.1",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "parse5": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
