{
  "name": "lah-skill-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:skill-search": "vite build --mode skill-search",
    "build:cms-plugin": "vite build --mode lah-team-formation",
    "build:team-creator": "vite build --mode team-creator",
    "build:editor": "vite build --mode editor",
    "watch:cms-plugin": "vite build --watch --mode lah-team-formation",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "eleventy:dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eleventy --serve --incremental",
    "eleventy:dev:fast": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eleventy --serve --incremental --ignore-initial",
    "eleventy:build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eleventy",
    "eleventy:strict": "cross-env ELEVENTY_STRICT=1 NODE_OPTIONS=--max-old-space-size=8192 eleventy",
    "test": "node --test \"wiki_plugins/**/*.test.js\" \"web/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@oddbird/popover-polyfill": "^0.7.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.15",
    "dialog-polyfill": "^0.5.6",
    "downshift": "9.4.0",
    "html-minifier-terser": "^7.2.0",
    "image-size": "^2.0.4",
    "js-yaml": "^4.3.2",
    "liquidjs": "^10.30.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.3",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "preact": "^10.29.8",
    "sass": "^1.105.2",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "parse5": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
